{
  "name": "holy-maidens-secrets",
  "version": "1.3.4",
  "description": "光之圣女的小秘密 - 工具集合",
  "main": "src/main/main.js",
  "author": "Kal'tsit Electronic Assistant System",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.kaltsit.holy-maidens-secrets",
    "productName": "光之圣女的小秘密",
    "copyright": "Copyright © 2026 Kal'tsit Electronic Assistant System",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "光之圣女的小秘密"
    },
    "extraResources": [
      {
        "from": "resources/daily-news",
        "to": "daily-news"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "chanyuzukiyukari-svg",
      "repo": "lightgirl",
      "releaseType": "release"
    }
  }
}
